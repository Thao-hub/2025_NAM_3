@using Microsoft.AspNetCore.Http.Extensions
@model List<Article>
@{
    ViewData["Title"] = ViewBag.Article.Title;
    ViewData["Description"] = ViewBag.Article.Description;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="home" asp-action="category"
                asp-route-slug="@ViewBag.Category.Slug" asp-route-id="@ViewBag.Category.Id">@ViewBag.Category.Name</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">@ViewBag.Article.Title</li>
    </ol>
</nav>

<div class="d-flex flex-wrap">
    @foreach (Category item in ViewBag.Categories)
    {
        <div class="flex-fill">
            <a asp-action="category" asp-route-slug="@item.Slug" asp-route-id="@item.Id" asp-controller="home">
                <img src="/images/@item.ImageUrl" alt="@item.Name">
            </a>
            <div>
                <a asp-controller="home" asp-action="category" asp-route-id="@item.Id"
                    asp-route-slug="@item.Slug">@item.Name</a>
            </div>
        </div>
    }
</div>

<div class="card mt-2">
    <div class="card-header">
        <h1 class="card-title">@ViewBag.Article.Title</h1>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-4">
                <img class="w-100" src="/articles/@ViewBag.Article.ImageUrl" alt="@ViewBag.Article.Title">
            </div>
            <div class="col-8">
                <p>Price: <b>@ViewBag.Article.Price</b></p>
                <div>@ViewBag.Article.Description</div>
                <div>@Html.Raw(ViewBag.Article.Feature)</div>
                <div id="fb-root"></div>
                <script async defer crossorigin="anonymous"
                    src="https://connect.facebook.net/vi_VN/sdk.js#xfbml=1&version=v19.0"></script>

                <div class="fb-like" data-href="@Context.Request.GetDisplayUrl()" data-layout="standard"
                    data-action="like" data-size="small" data-share="true">
                </div>
            </div>
        </div>
    </div>
</div>

<!--Native-->
<ul class="pagination mt-2">
    @for (int i = 1; i <= ViewBag.NumPages; i++)
    {
        <li class="page-item">
            @if (Context.GetPage(name: "page") == i)
            {
                <a class="active page-link" asp-route-page="@i" asp-controller="home" asp-action="details"
                    asp-route-slug="@ViewBag.Article.Slug" asp-route-id="@ViewBag.Article.Id">@i</a>
            }
            else
            {
                <a class="page-link" asp-route-page="@i" asp-controller="home" asp-action="details"
                    asp-route-slug="@ViewBag.Article.Slug" asp-route-id="@ViewBag.Article.Id">@i</a>
            }
        </li>
    }
</ul>

<div class="row">
    @foreach (Article item in Model)
    {
        <div class="col-3">
            <div class="border p-2 mt-2 rounded">
                <h2 class="h6">
                    <a asp-route-slug="@item.Slug" asp-controller="home" asp-action="details" asp-route-id="@item.Id">
                        @item.Title
                    </a>
                </h2>
                <div>
                    <img class="w-100" src="/articles/@item.ImageUrl" alt="@item.Title">
                </div>
                <div>
                    <p>Price: <b>@item.Price</b></p>
                </div>
            </div>
        </div>
    }
</div>