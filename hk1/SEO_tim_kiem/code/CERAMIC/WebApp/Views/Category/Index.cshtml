@model List<Category>

<a class="btn btn-primary" href="/category/add">Add</a>

<table class="table table-bordered mt-2">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Slug</th>
            <th>Heading</th>
            <th>Image</th>
            <th>Description</th>
            <th>Command</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Category item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Slug</td>
                <td>@item.Heading</td>
                <td>
                    <img width="80" src="/images/@item.ImageUrl" alt="@item.Name">
                </td>
                <td>@item.Description</td>
                <td>
                    <a class="btn btn-outline-primary" href="/category/delete/@item.Id">Delete</a>
                    <a class="btn btn-outline-primary" href="/category/edit/@item.Id">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>